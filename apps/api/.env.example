NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/learnhub
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@learnhub.example
ADMIN_PASSWORD=LearnHub123!
DEMO_EMAIL=demo@learnhub.example
DEMO_PASSWORD=LearnHubDemo123!

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:3001,https://learnhub.furqankhan.dev,https://learnhub-admin.furqankhan.dev

# Leave STRIPE_MOCK=1 for the demo. Add real keys only for a live checkout.
STRIPE_MOCK=1
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
